# Japanese (JIS 106), as the jp layout of X11 (docs/design/keymaps.md).
# Kana are typed with the input method of the compositor.
name "日本語 (JIS)"
include us
key grave none none
key 2 2 \"
key 6 6 &
key 7 7 '
key 8 8 (
key 9 9 )
key 0 0 none
key minus - =
key equal ^ ~
key yen \ |
key leftbrace @ `
key rightbrace [ {
key semicolon ; +
key apostrophe : *
key backslash ] }
key ro \ _
