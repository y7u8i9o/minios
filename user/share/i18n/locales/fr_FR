# French (France). The format is described in docs/design/locale.md.
# The values follow CLDR.
language_name "Français"
territory_name "France"

# LC_NUMERIC
decimal_point ","
thousands_sep " "
grouping "3"

# LC_MONETARY
int_curr_symbol "EUR "
currency_symbol "€"
mon_decimal_point ","
mon_thousands_sep " "
mon_grouping "3"
positive_sign ""
negative_sign "-"
int_frac_digits 2
frac_digits 2
p_cs_precedes 0
p_sep_by_space 1
n_cs_precedes 0
n_sep_by_space 1
p_sign_posn 1
n_sign_posn 1

# LC_TIME
abday "dim.;lun.;mar.;mer.;jeu.;ven.;sam."
day "dimanche;lundi;mardi;mercredi;jeudi;vendredi;samedi"
abmon "janv.;févr.;mars;avr.;mai;juin;juil.;août;sept.;oct.;nov.;déc."
mon "janvier;février;mars;avril;mai;juin;juillet;août;septembre;octobre;novembre;décembre"
am_pm ";"
d_t_fmt "%a %d %b %Y %T %Z"
d_fmt "%d/%m/%Y"
t_fmt "%T"
t_fmt_ampm ""
date_fmt "%a %d %b %Y %T %Z"

# LC_MESSAGES
yesexpr "^[+1oOyY]"
noexpr "^[-0nN]"
yesstr "oui"
nostr "non"

# LC_COLLATE
collate "latin"
