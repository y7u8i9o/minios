# Shared defaults for interactive console and Terminal sessions.
export PAGER=less
# Programs installed by pkg(1) live in /usr/bin, software that pkg does
# not manage in /usr/local/bin, and each user may keep programs in
# ~/.local/bin (docs/design/users.md).
case ":$PATH:" in *:/usr/bin:*) ;; *) PATH="$PATH:/usr/bin" ;; esac
case ":$PATH:" in *:/usr/local/bin:*) ;; *) PATH="$PATH:/usr/local/bin" ;; esac
export PATH="$PATH:$HOME/.local/bin"
alias ll='ls -lh'
alias la='ls -a'
if test -n "$TERM" && test "$TERM" != dumb && test -z "${NO_COLOR+x}"; then
    PS1='\[\e[32m\]\u\[\e[0m\]:\[\e[34m\]\w\[\e[0m\] \$ '
fi
# The language and the formats of the desktop settings, as startgui
# exports them (docs/design/desktop.md).
conf=/etc/desktop.conf
if [ -r "$HOME/.config/desktop.conf" ]; then conf="$HOME/.config/desktop.conf"; fi
lang=$(sed -n 's/^lang=//p' "$conf")
formats=$(sed -n 's/^formats=//p' "$conf")
if [ -n "$lang" ]; then export LANG="$lang"; fi
if [ -n "$formats" ]; then export LC_NUMERIC="$formats" LC_TIME="$formats" LC_MONETARY="$formats"; fi
unset conf lang formats
