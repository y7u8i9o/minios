# Shared defaults for interactive console and Terminal sessions.
export PAGER=less
# Programs installed by pkg(1) live under the package prefix.
export PATH="$PATH:/home/.local/bin"
alias ll='ls -lh'
alias la='ls -a'
if test -n "$TERM" && test "$TERM" != dumb && test -z "${NO_COLOR+x}"; then
    PS1='\[\e[32m\]\u\[\e[0m\]:\[\e[34m\]\w\[\e[0m\] \$ '
fi
