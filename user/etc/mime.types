# type extensions
text/plain txt md conf log
text/x-csrc c h
text/x-shellscript sh
text/x-lua lua
image/png png
image/bmp bmp dib
image/jpeg jpg jpeg jpe jfif
image/svg+xml svg
audio/x-wav wav wave
audio/flac flac
audio/ogg ogg oga
application/x-launcher app
application/x-minios-package mpk
application/octet-stream bin img
