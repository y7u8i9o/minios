#!/usr/bin/env python3
# The host sees the changes of the guest in the shared folder.
import os
import stat
import sys

share = os.environ["SHARE"]
errors = []


def expect(cond, text):
    if not cond:
        errors.append(text)


def read(name):
    try:
        with open(os.path.join(share, name)) as f:
            return f.read()
    except OSError as e:
        return f"<{e.strerror}>"


expect(read("guest.txt") == "written by the guest\nline 2\n", f"guest.txt: {read('guest.txt')!r}")
expect(stat.S_IMODE(os.stat(os.path.join(share, "guest.txt")).st_mode) == 0o600, "guest.txt is not mode 0600")
expect(read("tree/moved.txt") == "a\n", f"tree/moved.txt: {read('tree/moved.txt')!r}")
expect(not os.path.exists(os.path.join(share, "tree/sub")), "tree/sub remains")
expect(not os.path.exists(os.path.join(share, "old.txt")), "old.txt remains")
expect(not os.path.exists(os.path.join(share, "empty")), "empty remains")
expect(os.readlink(os.path.join(share, "guestlink")) == "guest.txt", "guestlink does not point to guest.txt")
expect(os.stat(os.path.join(share, "hard.txt")).st_ino == os.stat(os.path.join(share, "guest.txt")).st_ino,
       "hard.txt is not a hard link of guest.txt")
big = os.path.join(share, "big.bin")
expect(os.path.getsize(big) == 1048576, f"big.bin has {os.path.getsize(big)} bytes")
expect(not os.path.exists(os.path.join(share, "maptest")), "maptest remains")
if errors:
    for e in errors:
        print(f"post: {e}")
    sys.exit(1)
print("post: the host sees every change of the guest")
