#!/bin/sh
# The peer was started, saw the guest boot with a NIC attached and was
# stopped after QEMU exited; the capture exists (without a driver the
# guest sends nothing, so it holds the pcap header alone).
grep -q '^summary frames' "$PEER_LOG" || { echo "peer summary missing"; exit 1; }
[ -s "$CAPTURE" ] || { echo "capture missing"; exit 1; }
pid="$(sed -n 's/^netpeer pid \([0-9]*\).*/\1/p' "$PEER_LOG")"
[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && { echo "peer $pid still running"; exit 1; }
exit 0
