#!/bin/sh
MKFS="$BUILD/host/mkfs"
[ "$EXITCODE" = "0" ] || { echo "  qemu exit code $EXITCODE, expected 0"; exit 1; }
"$MKFS" --dump "$DISK" | head -1 | grep -q ' clean$' || { echo "  image not clean"; exit 1; }
[ "$("$MKFS" --cat "$DISK" /marker.txt)" = "before shutdown" ] || { echo "  marker missing"; exit 1; }
exit 0
