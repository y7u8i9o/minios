#!/bin/sh
set -eu
grep -q '^script syn mss 1460 wscale 2 sackok [01] ts 1$' "$PEER_LOG"
grep -q '^script received 100000 bytes pattern errors 0$' "$PEER_LOG"
grep -q '^script paws old segment answered without acceptance$' "$PEER_LOG"
grep -q '^script sent 3000 bytes and FIN acknowledged$' "$PEER_LOG"
grep -q '^script timestamps missing 0 echo errors 0$' "$PEER_LOG"
grep -q '^script complete$' "$PEER_LOG"
# The guest trusted the scaled window: segments ended beyond the edge an
# unscaled reading of the same field would give.
awk '/^script max flight/ { exit !($NF > 0) }' "$PEER_LOG"
# The guest advertised more than an unscaled window can express.
awk '/^script guest window/ { exit !($NF > 65535) }' "$PEER_LOG"
python3 "$TOP/tests/net/check_capture.py" --require window-scale --require timestamps "$CAPTURE"
