#!/usr/bin/env python3
# The screendumps of the qmp script have the followed sizes, and the panel
# spans the width of each: the bottom row has the panel colour at both ends.
import os
import sys

PANEL = (0x23, 0x27, 0x2c)


def read_ppm(path):
    with open(path, "rb") as f:
        data = f.read()
    fields, pos = [], 0
    while len(fields) < 4:
        while data[pos:pos + 1].isspace():
            pos += 1
        end = pos
        while not data[end:end + 1].isspace():
            end += 1
        fields.append(data[pos:end])
        pos = end
    if fields[0] != b"P6":
        raise ValueError(f"{path}: not a binary PPM")
    return int(fields[1]), int(fields[2]), data[pos + 1:]


def check(name, width, height):
    path = os.path.join(os.path.dirname(os.environ["SERIAL"]), name)
    w, h, pixels = read_ppm(path)
    if (w, h) != (width, height):
        print(f"post: {name} is {w}x{h}, expected {width}x{height}")
        return False
    row = (h - 2) * w * 3
    left = tuple(pixels[row + 3:row + 6])
    right = tuple(pixels[row + (w - 2) * 3:row + (w - 1) * 3])
    if left != PANEL or right != PANEL:
        print(f"post: {name}: bottom row {left} to {right}, expected the panel colour {PANEL}")
        return False
    print(f"post: {name} is {w}x{h} with the panel across the width")
    return True


ok = check("resize1.ppm", 1600, 1000)
ok = check("resize2.ppm", 1280, 720) and ok
sys.exit(0 if ok else 1)
