#!/usr/bin/env python3
# The screendumps of the qmp script have the followed sizes, and the panel
# spans the width of each: the bottom row has the panel colour at both ends.
import os
import sys

sys.path.insert(0, os.path.join(os.environ["TOP"], "tests"))
import ppm_pixels

PANEL = 0x23272c


def check(name, width, height):
    image = ppm_pixels.read(os.path.join(os.path.dirname(os.environ["SERIAL"]), name))
    w, h = image.width, image.height
    if (w, h) != (width, height):
        print(f"post: {name} is {w}x{h}, expected {width}x{height}")
        return False
    left, right = image.pixel(1, h - 2), image.pixel(w - 2, h - 2)
    if left != PANEL or right != PANEL:
        print(f"post: {name}: bottom row {left:06x} to {right:06x}, expected the panel colour {PANEL:06x}")
        return False
    print(f"post: {name} is {w}x{h} with the panel across the width")
    return True


ok = check("resize1.ppm", 1600, 1000)
ok = check("resize2.ppm", 1280, 720) and ok
sys.exit(0 if ok else 1)
