#!/bin/sh
# This script is the host side of the pkg_https case. It assembles the
# repository v1 of the pkg_repo case (repohello 1.0, repolib 1.0 and
# repoprog 1.0) with the build's signing key, and serves it over TLS 1.3
# with the server of pkg_repo on a free port. The guest reaches the port
# as 10.0.2.2 through QEMU user networking. The certificate of the server
# comes from tools/gen_tls_fixtures.py and is valid for 10.0.2.2 and
# repo.test. Its issuer is the test CA /etc/tests/tls-ca.pem of the guest.
set -eu
CASE="$(cd "$(dirname "$0")" && pwd)"
FIX="$BUILD/user/pkgrepo"
SIGN="$BUILD/host/pkgsign"
KEY="${PKG_KEY_FILE:-$BUILD/pkg/signing.key}"
WWW="$OUTDIR/www"
rm -rf "$WWW"
mkdir -p "$WWW"
REPO_SEQUENCE=100 "$TOP/tools/mkrepo.sh" "$SIGN" "$KEY" "$WWW/v1" \
    "$FIX/repohello-1.0.mpk" "$FIX/repolib-1.0.mpk" "$FIX/repoprog-1.0.mpk"
PORT=$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1])')
python3 "$CASE/../pkg_repo/server.py" "$PORT" "$WWW" "$CASE/server.pem" "$CASE/server.key" > "$PEER_LOG" 2>&1 &
SERVER=$!
echo $SERVER > "$PEER_PID"
# The harness stops this script; the server goes with it.
trap 'kill $SERVER 2>/dev/null; exit 0' TERM INT
# The peer is ready once the server accepts connections. A guest port of
# 0 asks the harness for no forward into the guest.
i=0
until python3 -c 'import socket, sys; socket.create_connection(("127.0.0.1", int(sys.argv[1])), 1)' "$PORT" 2>/dev/null; do
    i=$((i + 1))
    [ $i -lt 50 ] || { echo "peer: the server did not start" >&2; exit 1; }
    sleep 0.1
done
echo "$PORT 0" > "$PEER_READY"
wait $SERVER
