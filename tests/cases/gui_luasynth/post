#!/usr/bin/env python3
import os, struct
from pathlib import Path
path = Path(os.environ['SERIAL']).with_name('audio.wav')
data = path.read_bytes()
# isa-debug-exit can bypass WAV finalization. QEMU's fixed PCM header is
# still present, but its RIFF/data lengths may be zero. The WAV backend
# resamples the guest's 48 kHz output to its own (normally 44.1 kHz) rate.
assert len(data) >= 44 and data[:4] == b'RIFF' and data[8:16] == b'WAVEfmt '
assert struct.unpack_from('<IHH', data, 16) == (16, 1, 2)
assert struct.unpack_from('<H', data, 34)[0] == 16 and data[36:40] == b'data'
rate = struct.unpack_from('<I', data, 24)[0]
assert rate in (44100, 48000) and (len(data) - 44) % 4 == 0
values = struct.unpack_from('<' + 'h' * ((len(data) - 44) // 2), data, 44)
left, right = values[::2], values[1::2]
active = sum(abs(l) > 200 or abs(r) > 200 for l, r in zip(left, right))
stereo = sum(abs(l - r) > 100 for l, r in zip(left, right))
assert active >= 12000, f'only {active} audible frames'
assert stereo >= 6000, f'only {stereo} stereo frames'
assert max(map(abs, values)) > 1000
print(f'gui_luasynth post: verified {active} audible frames, {stereo} stereo frames')
