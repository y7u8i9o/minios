#!/bin/sh
# Decode the screenshot, the window capture and the saved drawing on the
# host: the screenshot has the screen size printed by the test and shows
# the desktop colour, the window is opaque in the middle and transparent
# in its rounded top left corner, and the drawing is 640x480 white with
# the black stroke from (50,50) to (250,50).
FSCK="$BUILD/host/fsck"
MKFS="$BUILD/host/mkfs"
"$FSCK" -y "$DISK" > "$DISK.fsck" 2>&1
RC=$?
[ "$RC" = 0 ] || [ "$RC" = 1 ] || { echo "  fsck -y exit $RC"; cat "$DISK.fsck"; exit 1; }
DIR="$(dirname "$DISK")"
"$MKFS" --cat "$DISK" /shot.png > "$DIR/shot.png" || { echo "  /shot.png missing"; exit 1; }
"$MKFS" --cat "$DISK" /drawing.png > "$DIR/drawing.png" || { echo "  /drawing.png missing"; exit 1; }
"$MKFS" --cat "$DISK" /win.png > "$DIR/win.png" || { echo "  /win.png missing"; exit 1; }
"$MKFS" --cat "$DISK" /drawing.bmp > "$DIR/drawing.bmp" || { echo "  /drawing.bmp missing"; exit 1; }
SIZE="$(sed -n 's/.*gui_images: screen \([0-9]*x[0-9]*\).*/\1/p' "$SERIAL" | head -1)"
exec python3 - "$DIR/shot.png" "$DIR/drawing.png" "$SIZE" "$DIR/win.png" "$DIR/drawing.bmp" <<'PY'
import struct, sys, zlib

def decode(path):
    data = open(path, "rb").read()
    assert data[:8] == b"\x89PNG\r\n\x1a\n", "signature"
    pos, idat = 8, b""
    while pos < len(data):
        n, tag = struct.unpack(">I4s", data[pos:pos + 8])
        body = data[pos + 8:pos + 8 + n]
        crc = struct.unpack(">I", data[pos + 8 + n:pos + 12 + n])[0]
        assert zlib.crc32(tag + body) & 0xffffffff == crc, "CRC of " + tag.decode()
        if tag == b"IHDR":
            w, h, depth, ctype, _, _, interlace = struct.unpack(">IIBBBBB", body)
        elif tag == b"IDAT":
            idat += body
        pos += 12 + n
    assert depth == 8 and ctype in (2, 6) and interlace == 0, "format"
    bpp = 3 if ctype == 2 else 4
    raw = zlib.decompress(idat)
    stride = w * bpp
    assert len(raw) == (stride + 1) * h, "data length"
    rows, prev = [], bytearray(stride)
    for y in range(h):
        f, line = raw[y * (stride + 1)], bytearray(raw[y * (stride + 1) + 1:(y + 1) * (stride + 1)])
        for i in range(stride):
            a = line[i - bpp] if i >= bpp else 0
            b = prev[i]
            c = prev[i - bpp] if i >= bpp else 0
            if f == 1: line[i] = (line[i] + a) & 255
            elif f == 2: line[i] = (line[i] + b) & 255
            elif f == 3: line[i] = (line[i] + (a + b) // 2) & 255
            elif f == 4:
                p = a + b - c
                pa, pb, pc = abs(p - a), abs(p - b), abs(p - c)
                line[i] = (line[i] + (a if pa <= pb and pa <= pc else b if pb <= pc else c)) & 255
            else: assert f == 0, "filter %d" % f
        rows.append(line)
        prev = line
    return w, h, bpp, rows

def px(img, x, y):
    w, h, bpp, rows = img
    return tuple(rows[y][x * bpp:x * bpp + 3])

shot = decode(sys.argv[1])
want = tuple(int(v) for v in sys.argv[3].split("x"))
if (shot[0], shot[1]) != want:
    sys.exit("  screenshot is %dx%d, the screen %dx%d" % (shot[0], shot[1], want[0], want[1]))
desk = sum(1 for y in range(0, shot[1], 4) for x in range(0, shot[0], 4) if px(shot, x, y) == (0x30, 0x60, 0x80))
total = (shot[0] // 4) * (shot[1] // 4)
if desk < total // 2:
    sys.exit("  screenshot shows the desktop colour in %d of %d samples" % (desk, total))
win = decode(sys.argv[4])
if win[2] != 4:
    sys.exit("  the window image has no alpha")
alpha = lambda img, x, y: img[3][y][x * 4 + 3]
if alpha(win, 0, 0) != 0 or alpha(win, win[0] // 2, win[1] // 2) != 255:
    sys.exit("  window alpha: corner %d, middle %d" % (alpha(win, 0, 0), alpha(win, win[0] // 2, win[1] // 2)))
drawing = decode(sys.argv[2])
if drawing[:2] != (640, 480):
    sys.exit("  drawing is %dx%d" % drawing[:2])
for x, y, colour in ((60, 50, (0, 0, 0)), (150, 50, (0, 0, 0)), (240, 50, (0, 0, 0)),
                     (150, 100, (255, 255, 255)), (10, 10, (255, 255, 255)), (639, 479, (255, 255, 255))):
    if px(drawing, x, y) != colour:
        sys.exit("  drawing pixel (%d,%d) is %s" % (x, y, px(drawing, x, y)))
# The BMP copy of the drawing: a V4 header, 32 bit BI_BITFIELDS pixels
# bottom up, with the same pixels as the PNG file.
bmp = open(sys.argv[5], "rb").read()
off, hsize = struct.unpack("<I", bmp[10:14])[0], struct.unpack("<I", bmp[14:18])[0]
bw, bh, planes, bpp, comp = struct.unpack("<iiHHI", bmp[18:34])
if bmp[:2] != b"BM" or hsize != 108 or (bw, bh, bpp, comp) != (640, 480, 32, 3):
    sys.exit("  drawing.bmp header: %d %dx%d %d bit compression %d" % (hsize, bw, bh, bpp, comp))
def bmp_px(x, y):
    b, g, r, a = bmp[off + ((bh - 1 - y) * bw + x) * 4:off + ((bh - 1 - y) * bw + x) * 4 + 4]
    return (r, g, b)
for x, y in ((60, 50), (150, 50), (240, 50), (150, 100), (10, 10), (639, 479)):
    if bmp_px(x, y) != px(drawing, x, y):
        sys.exit("  drawing.bmp pixel (%d,%d) is %s, the PNG %s" % (x, y, bmp_px(x, y), px(drawing, x, y)))
print("  screenshot %dx%d, desktop colour in %d of %d samples; window %dx%d with a transparent corner; "
      "drawing 640x480 with the stroke, also as BMP" % (shot[0], shot[1], desk, total, win[0], win[1]))
PY
