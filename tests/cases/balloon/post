#!/usr/bin/env python3
# The host side of the balloon case: query-balloon reports the guest memory
# after the inflation and after the deflation, and the guest statistics
# contain the total memory that the guest printed.
import json
import os
import re
import sys

log_dir = os.path.dirname(os.environ["SERIAL"])
results = {}
command = None
with open(os.path.join(log_dir, "qmp.log")) as f:
    for line in f:
        line = line.rstrip("\n")
        if line.startswith("qmp "):
            command = line.split()[1]
        elif command and line.startswith("{"):
            results.setdefault(command, []).append(json.loads(line))
            command = None

ok = True
actual = [r.get("actual") for r in results.get("query-balloon", [])]
if actual != [402653184, 536870912]:
    print(f"post: query-balloon reported {actual}, expected [402653184, 536870912]")
    ok = False

with open(os.environ["SERIAL"], errors="replace") as f:
    m = re.search(r"balloon: inflated to \d+ pages, MemTotal (\d+) kB", f.read())
stats = (results.get("qom-get") or [{}])[0]
total = stats.get("stats", {}).get("stat-total-memory")
if not m or total != int(m.group(1)) * 1024:
    print(f"post: stat-total-memory {total}, the guest printed {m.group(0) if m else 'nothing'}")
    ok = False
free = stats.get("stats", {}).get("stat-free-memory", -1)
if free <= 0 or stats.get("last-update", 0) <= 0:
    print(f"post: guest statistics without free memory or update time: {stats}")
    ok = False
if ok:
    print(f"post: query-balloon {actual}, stat-total-memory {total}, stat-free-memory {free}")
sys.exit(0 if ok else 1)
