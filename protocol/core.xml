<?xml version="1.0" encoding="UTF-8"?>
<!-- Core display protocol of minios (M24). Object ids: clients allocate
     from 1, the server from 0xff000000. Message header: object id (u32),
     opcode (u16), size in bytes including the header (u16). Argument
     encodings: int/uint 4 bytes, fixed 24.8 in 4 bytes, string as u32
     length including the NUL then bytes padded to 4, array as u32 length
     then bytes padded to 4, object/new_id as u32, fd out of band in an
     SCM_RIGHTS record in argument order. -->
<protocol name="core">
  <interface name="display" version="1">
    <request name="sync">
      <arg name="callback" type="new_id" interface="callback"/>
    </request>
    <request name="get_registry">
      <arg name="registry" type="new_id" interface="registry"/>
    </request>
    <event name="error">
      <arg name="object" type="uint"/>
      <arg name="code" type="uint"/>
      <arg name="message" type="string"/>
    </event>
    <event name="delete_id">
      <arg name="id" type="uint"/>
    </event>
  </interface>

  <interface name="registry" version="1">
    <request name="bind">
      <arg name="name" type="uint"/>
      <arg name="interface" type="string"/>
      <arg name="version" type="uint"/>
      <arg name="id" type="new_id"/>
    </request>
    <event name="global">
      <arg name="name" type="uint"/>
      <arg name="interface" type="string"/>
      <arg name="version" type="uint"/>
    </event>
    <event name="global_remove">
      <arg name="name" type="uint"/>
    </event>
  </interface>

  <interface name="callback" version="1">
    <event name="done">
      <arg name="data" type="uint"/>
    </event>
  </interface>

  <interface name="compositor" version="1">
    <request name="create_surface">
      <arg name="id" type="new_id" interface="surface"/>
    </request>
  </interface>

  <interface name="shm" version="1">
    <request name="create_pool">
      <arg name="id" type="new_id" interface="shm_pool"/>
      <arg name="fd" type="fd"/>
      <arg name="size" type="int"/>
    </request>
    <event name="format">
      <arg name="format" type="uint"/>
    </event>
  </interface>

  <interface name="shm_pool" version="1">
    <request name="create_buffer">
      <arg name="id" type="new_id" interface="buffer"/>
      <arg name="offset" type="int"/>
      <arg name="width" type="int"/>
      <arg name="height" type="int"/>
      <arg name="stride" type="int"/>
      <arg name="format" type="uint"/>
    </request>
    <request name="resize">
      <arg name="size" type="int"/>
    </request>
    <request name="destroy" type="destructor"/>
  </interface>

  <interface name="buffer" version="1">
    <request name="destroy" type="destructor"/>
    <event name="release"/>
  </interface>

  <interface name="surface" version="1">
    <request name="attach">
      <arg name="buffer" type="object" interface="buffer" allow-null="true"/>
      <arg name="x" type="int"/>
      <arg name="y" type="int"/>
    </request>
    <request name="damage">
      <arg name="x" type="int"/>
      <arg name="y" type="int"/>
      <arg name="width" type="int"/>
      <arg name="height" type="int"/>
    </request>
    <request name="frame">
      <arg name="callback" type="new_id" interface="callback"/>
    </request>
    <request name="set_opaque_region">
      <arg name="rects" type="array"/>
    </request>
    <request name="commit"/>
    <request name="destroy" type="destructor"/>
    <!-- Rectangles are packed as signed x,y,width,height tuples.  An
         empty opaque region means no opacity hint; an empty input region
         disables content input. -->
    <request name="set_input_region">
      <arg name="rects" type="array"/>
    </request>
    <request name="set_buffer_scale">
      <arg name="scale" type="int"/>
    </request>
    <!-- 0, 1, 2 and 3 are rotations by 0, 90, 180 and 270 degrees. -->
    <request name="set_buffer_transform">
      <arg name="transform" type="uint"/>
    </request>
    <request name="damage_buffer">
      <arg name="x" type="int"/>
      <arg name="y" type="int"/>
      <arg name="width" type="int"/>
      <arg name="height" type="int"/>
    </request>
    <event name="enter">
      <arg name="output" type="object" interface="output"/>
    </event>
  </interface>

  <interface name="output" version="1">
    <event name="geometry">
      <arg name="x" type="int"/>
      <arg name="y" type="int"/>
      <arg name="width" type="int"/>
      <arg name="height" type="int"/>
    </event>
    <event name="mode">
      <arg name="width" type="int"/>
      <arg name="height" type="int"/>
      <arg name="refresh" type="int"/>
    </event>
    <event name="scale"><arg name="factor" type="int"/></event>
    <event name="transform"><arg name="transform" type="uint"/></event>
    <event name="done"/>
  </interface>
</protocol>
