<?xml version="1.0" encoding="UTF-8"?>
<!-- Debugging and settings interfaces of the compositor. -->
<protocol name="debug">
  <!-- Version 2 adds the frame statistics (docs/design/graphics-performance.md).
       get_frame_stats sends one frame_stat event per value, then
       frame_stats_done. A value has 64 bits, sent as its high and its low
       half. reset_frame_stats sets the counters to zero and starts the
       period that elapsed_us measures.
       Version 3 adds the frame history (X2 of docs/plan/x12settings.md).
       X12 records the last 1024 frames. get_frame_history sends one frame
       event per recorded frame with a serial above after, oldest first,
       then frame_history_done with the serial of the newest frame. The
       serials count the frames since the start of X12, from 1, and a
       reset of the statistics does not clear the history. latency_us is
       the longest latency that the frame ended. -->
  <interface name="debug" version="3">
    <request name="get_stats"/>
    <request name="get_surfaces"/>
    <request name="read_pixel"><arg name="x" type="int"/><arg name="y" type="int"/></request>
    <request name="get_frame_stats"/>
    <request name="reset_frame_stats"/>
    <event name="stats">
      <arg name="uptime_ms" type="uint"/><arg name="compositions" type="uint"/><arg name="compose_ms" type="uint"/>
      <arg name="compose_max_ms" type="uint"/><arg name="clients" type="uint"/><arg name="surfaces" type="uint"/>
      <arg name="frame_ms" type="uint"/>
    </event>
    <event name="surface">
      <arg name="id" type="uint"/><arg name="client" type="uint"/><arg name="role" type="string"/><arg name="title" type="string"/>
      <arg name="x" type="int"/><arg name="y" type="int"/><arg name="width" type="int"/><arg name="height" type="int"/>
      <arg name="mapped" type="uint"/><arg name="format" type="uint"/>
    </event>
    <event name="surfaces_done"/>
    <event name="pixel"><arg name="x" type="int"/><arg name="y" type="int"/><arg name="value" type="uint"/></event>
    <event name="frame_stat">
      <arg name="key" type="string"/><arg name="high" type="uint"/><arg name="low" type="uint"/>
    </event>
    <event name="frame_stats_done"/>
    <request name="get_frame_history"><arg name="after" type="uint"/></request>
    <event name="frame">
      <arg name="serial" type="uint"/><arg name="end_ms" type="uint"/><arg name="total_us" type="uint"/>
      <arg name="compose_us" type="uint"/><arg name="flush_us" type="uint"/><arg name="pixels" type="uint"/>
      <arg name="latency_us" type="uint"/>
    </event>
    <event name="frame_history_done"><arg name="last" type="uint"/></event>
  </interface>

  <!-- The protocol traffic of every other client (wireview). start sends
       a client event for each connected client, then one message event
       per request the server decodes and per event it queues, until stop.
       direction is 0 for a request and 1 for an event. The traffic of
       clients that trace is never traced. When the tracer's socket backs
       up, messages are counted instead of sent and reported by dropped. -->
  <interface name="tracer" version="1">
    <request name="start"/>
    <request name="stop"/>
    <request name="destroy" type="destructor"/>
    <event name="client"><arg name="number" type="uint"/><arg name="pid" type="uint"/><arg name="connected" type="uint"/></event>
    <event name="message">
      <arg name="seq" type="uint"/><arg name="time_ms" type="uint"/><arg name="client" type="uint"/>
      <arg name="direction" type="uint"/><arg name="object" type="uint"/><arg name="interface" type="string"/>
      <arg name="name" type="string"/><arg name="arguments" type="string"/><arg name="size" type="uint"/>
    </event>
    <event name="dropped"><arg name="count" type="uint"/></event>
  </interface>

  <!-- Screen capture (screenshot). Binding sends size with the screen in
       device pixels and the scale, again after a mode change. capture
       copies the last composed frame into a shared memory buffer of that
       size and sends done, or failed when the buffer has another size.
       With pointer 0 the frame is copied without the pointer; with 1 it
       contains the pointer, and pointer reports its rectangle in device
       pixels before done (an empty one when the pointer is hidden).
       get_windows sends one window event per mapped toplevel, the top of
       the stack first, with its visible frame in logical pixels and the
       size of its image in device pixels, then windows_done.
       capture_window draws the toplevel with that number alone, with its
       shadow, into an ARGB buffer of the image size, and sends done, or
       failed for an unknown window or a buffer of another size. -->
  <interface name="screencopy" version="1">
    <request name="capture">
      <arg name="buffer" type="object" interface="buffer"/><arg name="pointer" type="uint"/>
    </request>
    <request name="destroy" type="destructor"/>
    <request name="get_windows"/>
    <request name="capture_window">
      <arg name="buffer" type="object" interface="buffer"/><arg name="window" type="uint"/>
    </request>
    <event name="size"><arg name="width" type="int"/><arg name="height" type="int"/><arg name="scale" type="int"/></event>
    <event name="done"/>
    <event name="failed"/>
    <event name="pointer">
      <arg name="x" type="int"/><arg name="y" type="int"/><arg name="width" type="int"/><arg name="height" type="int"/>
    </event>
    <event name="window">
      <arg name="window" type="uint"/><arg name="x" type="int"/><arg name="y" type="int"/>
      <arg name="width" type="int"/><arg name="height" type="int"/><arg name="activated" type="uint"/>
      <arg name="title" type="string"/><arg name="image_width" type="int"/><arg name="image_height" type="int"/>
    </event>
    <event name="windows_done"/>
  </interface>

  <interface name="settings" version="1">
    <request name="set"><arg name="key" type="string"/><arg name="value" type="int"/></request>
    <request name="get_all"/>
    <event name="value"><arg name="key" type="string"/><arg name="value" type="int"/></event>
    <event name="done"/>
  </interface>
</protocol>
